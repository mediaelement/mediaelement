{
  "name": "mediaelement",
  "license": "MIT",
  "version": "7.1.0",
  "main": "full.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/mediaelement/mediaelement.git"
  },
  "bugs": {
    "url": "https://github.com/mediaelement/mediaelement/issues?q=is%3Aissue+is%3Aopen+label%3ABug"
  },
  "private": false,
  "devDependencies": {
    "@vitejs/plugin-legacy": "^5.4.1",
    "autoprefixer": "^10.4.19",
    "cssnano": "^7.0.1",
    "eslint": "^8.57.0",
    "postcss": "^8.4.38",
    "rimraf": "^5.0.7",
    "stylelint": "^16.6.1",
    "stylelint-order": "^6.0.4",
    "terser": "^5.31.0",
    "vite": "^5.2.12",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "global": "^4.3.1",
    "promise-polyfill": "6.0.2",
    "svg4everybody": "^2.1.9"
  },
  "scripts": {
    "build": "vite build",
    "build:debug": "vite build --mode development",
    "dev": "vite",
    "preview": "vite preview",
    "lint": "eslint src/js/**/*.js test/**/*.js",
    "lint:fix": "eslint src/js/**/*.js test/**/*.js --fix",
    "stylelint": "stylelint src/css/*.css",
    "stylelint:fix": "stylelint src/css/*.css --fix",
    "lint:all": "npm run lint && npm run stylelint",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "build:features": "vite build --features",
    "clean": "rimraf build"
  }
